{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@adaptive-ds/solid-ui/static/badge/Badge": ["./ui/static/badge/Badge.tsx"],
      "@adaptive-ds/solid-ui/static/badge/badgeCva": ["./ui/static/badge/badgeCva.tsx"],
      "@adaptive-ds/solid-ui/utils/createSignalObject": ["./ui/utils/createSignalObject.ts"],
      "@corvu/popover": ["./node_modules/@corvu/popover/dist/index.d.ts"],
      "@mdi/js": ["./node_modules/@mdi/js/mdi.d.ts"],
      "#ui/*": ["./ui/*"],
      "clsx": ["./node_modules/clsx/clsx.d.mts"],
      "solid-js": ["./node_modules/solid-js/types/index.d.ts"],
      "solid-js/jsx-runtime": ["./node_modules/solid-js/types/jsx.d.ts"],
      "solid-js/*": ["./node_modules/solid-js/*"],
      "tailwind-merge": ["./node_modules/tailwind-merge/dist/types.d.ts"]
    },
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "noEmit": true,
    //
    // dom
    //
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    //
    // performance
    //
    "isolatedModules": true,
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": "./build/tsconfig.tsbuildinfo",
    //
    // my configs
    //
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "useDefineForClassFields": true,
    "moduleDetection": "force",
    "noUncheckedSideEffectImports": true,
    //
    // type imports - https://www.typescriptlang.org/tsconfig#verbatimModuleSyntax
    //
    "verbatimModuleSyntax": true,
    //
    // https://devblogs.microsoft.com/typescript/announcing-typescript-5-8/#the---erasablesyntaxonly-option
    //
    "erasableSyntaxOnly": true,
    //
    // code quality settings
    //
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["client", "src", "test", "e2e", "playwright.config.ts"],
  "exclude": [
    ".github",
    ".roo",
    ".idea",
    ".vscode",
    ".wrangler",
    "changelogs",
    "build",
    "dist",
    "out",
    "data",
    "docs",
    "node_modules",
    "ops",
    "public",
    "public-image-versions",
    "public-images"
  ]
}
