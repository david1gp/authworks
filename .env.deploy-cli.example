# Copy to .env.deploy-cli and configure targets for this account.
# The file is parsed as text and never sourced; unsafe values stay inert.
# Targets are explicit: none are inferred from the account or host.
# Exported variables (including empty values) override this file per key.
# Empty or missing AUTHWORKS_CLI_DEPLOY_TARGETS means no CLI is deployed
# (the deploy is then a no-op), so the repository stays generic by default.
# Unset or empty AUTHWORKS_CLI_REQUIRED_TARGETS means no requirements.
#
# Target grammar (space separated):
#   local            current account, per-user install in
#                    ~/.local/share/authworks-cli + ~/.local/bin/authworks
#   system           this machine, system-wide install; requires root
#   user@host        remote account, per-user install over ssh
#   user@host:system remote machine, system-wide install over ssh
#                    (the account must be able to write the system prefix and
#                    the shared binary directory, e.g. root@host:system)
#
# A listed but unreachable target fails the run only when it is also listed in
# AUTHWORKS_CLI_REQUIRED_TARGETS; other failures warn.
#
# Examples:
# AUTHWORKS_CLI_DEPLOY_TARGETS="local"
# AUTHWORKS_CLI_DEPLOY_TARGETS="system"
# AUTHWORKS_CLI_DEPLOY_TARGETS="root@host:system"
# AUTHWORKS_CLI_DEPLOY_TARGETS="local root@host:system"
AUTHWORKS_CLI_DEPLOY_TARGETS=""
AUTHWORKS_CLI_REQUIRED_TARGETS=""

# System-wide install overrides (defaults shown):
# AUTHWORKS_CLI_SYSTEM_PREFIX="/opt"
# AUTHWORKS_CLI_SYSTEM_BIN_DIR="/usr/local/bin"
