{
  "name": "@adaptive-ds/zitadel-v2",
  "version": "0.1.0",
  "description": "Backend-first identity platform: Hono server, typed API client library, and CLI. Users, orgs, OIDC, MFA, and events on SQLite.",
  "keywords": [
    "zitadel",
    "identity",
    "oidc",
    "oauth2",
    "authentication",
    "authorization",
    "mfa",
    "webauthn",
    "passkeys",
    "multi-tenant",
    "hono",
    "sqlite",
    "drizzle",
    "valibot",
    "typescript",
    "bun",
    "cli",
    "adaptive-ds"
  ],
  "homepage": "https://github.com/david1gp/zitadel-v2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david1gp/zitadel-v2.git"
  },
  "bugs": {
    "url": "https://github.com/david1gp/zitadel-v2/issues"
  },
  "author": {
    "name": "David Siewert",
    "url": "https://david-siewert.com/"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/david1gp"
  },
  "license": "MIT",
  "readme": "README.md",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "main": "dist/outputs/library.js",
  "types": "./dist/outputs/library.d.ts",
  "bin": {
    "zitadel-v2": "./dist/outputs/cli.js"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run src/outputs/server.ts",
    "test": "bun test",
    "test:w": "bun test --watch",
    "tsc": "tsc --noEmit",
    "build": "rm -rf ./dist && tsc -p ./tsconfig.lib.json",
    "release": "bash ./ops/release.sh",
    "deploy": "bash ./ops/deploy.sh",
    "format": "biome format --write src test ops package.json tsconfig.json tsconfig.lib.json biome.json bunfig.toml cliff.toml README.md",
    "update": "bun update",
    "update:commit": "bun update && git add package.json && bun run tsc && git commit -m \"chore(deps): update dependencies\" && git push",
    "clean": "rm -rf ./dist",
    "reset": "rm -rf ./node_modules"
  },
  "peerDependencies": {
    "@adaptive-ds/result": ">=0.4.0",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "trailingComma": "all"
  },
  "imports": {
    "#result": "@adaptive-ds/result"
  },
  "exports": {
    ".": {
      "types": "./dist/outputs/library.d.ts",
      "import": "./dist/outputs/library.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
