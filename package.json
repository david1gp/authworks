{
  "name": "@adaptive-ds/authworks",
  "version": "0.1.0",
  "description": "Backend-first identity platform: Hono server, typed API client library, and CLI. Users, orgs, OIDC, MFA, and events on SQLite.",
  "keywords": [
    "authworks",
    "identity",
    "oidc",
    "oauth2",
    "authentication",
    "authorization",
    "mfa",
    "webauthn",
    "passkeys",
    "multi-tenant",
    "hono",
    "sqlite",
    "drizzle",
    "valibot",
    "typescript",
    "bun",
    "cli",
    "adaptive-ds"
  ],
  "homepage": "https://github.com/david1gp/authworks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david1gp/authworks.git"
  },
  "bugs": {
    "url": "https://github.com/david1gp/authworks/issues"
  },
  "author": {
    "name": "David Siewert",
    "url": "https://david-siewert.com/"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/david1gp"
  },
  "license": "MIT",
  "readme": "README.md",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "main": "./dist/library/outputs/library.js",
  "types": "./dist/library/outputs/library.d.ts",
  "bin": {
    "authworks": "./dist/cli/cli.js"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run --parallel dev:api dev:ui",
    "dev:api": "bun run --watch src/outputs/server.ts",
    "dev:ui": "vite",
    "test": "bun test --max-concurrency=1 --dots --bail=1 test/packageName.test.ts test/libraryExports.test.ts test/platform test/features test/cli test/conformance test/ui",
    "test:e2e": "playwright test",
    "test:mailcow": "bun test test/integration/mailcowEmail.test.ts",
    "test:w": "bun test --watch test/packageName.test.ts test/libraryExports.test.ts test/platform test/features test/cli test/conformance test/ui",
    "test:build": "bun run build && bun test --max-concurrency=1 --dots --bail=1 test/build",
    "test:all": "bun run test && bun run test:build",
    "check:no-literal-ui-text": "bun run scripts/uiTextLiteralsCheck.ts",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "tsc": "tsc -p ./tsconfig.json --noEmit",
    "build": "bun run clean && bun run typecheck && bun run build:library && bun run build:server && bun run build:cli && bun run build:ui",
    "build:library": "tsc -p ./tsconfig.lib.json && cp ./package.json ./dist/package.json",
    "build:server": "bun build ./src/outputs/server.ts --outfile ./dist/server/server.js --target bun --format esm",
    "build:cli": "bun build ./src/outputs/cli.ts --outfile ./dist/cli/cli.js --target bun --format esm && chmod +x ./dist/cli/cli.js",
    "build:ui": "vite build",
    "smoke:public": "bash ./ops/public-smoke.sh",
    "verify:outputs": "bun run test:build",
    "check": "bun run format:check && bun run check:no-literal-ui-text && bun run typecheck && bun run test && bun run build && bun test --max-concurrency=1 --dots --bail=1 test/build",
    "release": "bash ./ops/release.sh",
    "deploy": "prodctl deploy",
    "production:logs": "prodctl logs",
    "format": "biome format --write src test e2e ops scripts ui index.html vite.config.ts playwright.config.ts package.json tsconfig.json tsconfig.lib.json biome.json bunfig.toml cliff.toml README.md",
    "format:check": "biome format src test e2e ops scripts ui index.html vite.config.ts playwright.config.ts package.json tsconfig.json tsconfig.lib.json biome.json bunfig.toml cliff.toml README.md",
    "ui": "rsync -avh --delete ../solid-ui/ui/ ./ui/",
    "ui:push": "rsync -avh --delete ./ui/ ../solid-ui/ui/",
    "update": "bun update",
    "update:commit": "bun update && git add package.json && bun run tsc && git commit -m \"chore(deps): update dependencies\" && git push",
    "clean": "rm -rf ./dist",
    "reset": "rm -rf ./node_modules"
  },
  "peerDependencies": {
    "@adaptive-ds/result": ">=0.4.0",
    "valibot": "^1.4.2"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "trailingComma": "all"
  },
  "imports": {
    "#result": "@adaptive-ds/result",
    "#ui/*": "./ui/*",
    "#utils/*": "@adaptive-ds/utils/*"
  },
  "exports": {
    ".": {
      "types": "./dist/library/outputs/library.d.ts",
      "import": "./dist/library/outputs/library.js"
    },
    "./library": {
      "types": "./dist/library/outputs/library.d.ts",
      "import": "./dist/library/outputs/library.js"
    },
    "./authorization": {
      "types": "./dist/library/outputs/library/authorization.d.ts",
      "import": "./dist/library/outputs/library/authorization.js"
    },
    "./email": {
      "types": "./dist/library/outputs/library/email.d.ts",
      "import": "./dist/library/outputs/library/email.js"
    },
    "./emailOtp": {
      "types": "./dist/library/outputs/library/emailOtp.d.ts",
      "import": "./dist/library/outputs/library/emailOtp.js"
    },
    "./whatsappOtp": {
      "types": "./dist/library/outputs/library/whatsappOtp.d.ts",
      "import": "./dist/library/outputs/library/whatsappOtp.js"
    },
    "./events": {
      "types": "./dist/library/outputs/library/events.d.ts",
      "import": "./dist/library/outputs/library/events.js"
    },
    "./externalIdentities": {
      "types": "./dist/library/outputs/library/externalIdentities.d.ts",
      "import": "./dist/library/outputs/library/externalIdentities.js"
    },
    "./impersonation": {
      "types": "./dist/library/outputs/library/impersonation.d.ts",
      "import": "./dist/library/outputs/library/impersonation.js"
    },
    "./machineUsers": {
      "types": "./dist/library/outputs/library/machineUsers.d.ts",
      "import": "./dist/library/outputs/library/machineUsers.js"
    },
    "./mfa": {
      "types": "./dist/library/outputs/library/mfa.d.ts",
      "import": "./dist/library/outputs/library/mfa.js"
    },
    "./oidc": {
      "types": "./dist/library/outputs/library/oidc.d.ts",
      "import": "./dist/library/outputs/library/oidc.js"
    },
    "./organizations": {
      "types": "./dist/library/outputs/library/organizations.d.ts",
      "import": "./dist/library/outputs/library/organizations.js"
    },
    "./passkeys": {
      "types": "./dist/library/outputs/library/passkeys.d.ts",
      "import": "./dist/library/outputs/library/passkeys.js"
    },
    "./passwords": {
      "types": "./dist/library/outputs/library/passwords.d.ts",
      "import": "./dist/library/outputs/library/passwords.js"
    },
    "./projects": {
      "types": "./dist/library/outputs/library/projects.d.ts",
      "import": "./dist/library/outputs/library/projects.js"
    },
    "./realms": {
      "types": "./dist/library/outputs/library/realms.d.ts",
      "import": "./dist/library/outputs/library/realms.js"
    },
    "./sessions": {
      "types": "./dist/library/outputs/library/sessions.d.ts",
      "import": "./dist/library/outputs/library/sessions.js"
    },
    "./users": {
      "types": "./dist/library/outputs/library/users.d.ts",
      "import": "./dist/library/outputs/library/users.js"
    },
    "./server": {
      "import": "./dist/server/server.js"
    },
    "./cli": {
      "import": "./dist/cli/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@adaptive-ds/mdi": "^0.1.2",
    "@adaptive-ds/solid-ui": "^0.19.1",
    "@adaptive-ds/utils": "^0.12.0",
    "@adaptive-ds/waha-client": "^0.2.1",
    "@corvu/dialog": "^0.2.4",
    "@corvu/popover": "^0.2.0",
    "@simplewebauthn/server": "^13.2.2",
    "@solid-primitives/keyed": "^1.5.3",
    "@solid-primitives/scheduled": "^1.5.2",
    "@solidjs/router": "^1.0.0",
    "@stricli/core": "^1.3.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "imapflow": "^1.7.2",
    "nodemailer": "^9.0.5",
    "qrcode-generator": "^2.0.4",
    "solid-js": "^1.9.12",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "happy-dom": "^20.11.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14"
  }
}
