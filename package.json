{
  "name": "@adaptive-ds/zitadel-v2",
  "version": "0.1.0",
  "description": "Backend-first identity platform: Hono server, typed API client library, and CLI. Users, orgs, OIDC, MFA, and events on SQLite.",
  "keywords": [
    "zitadel",
    "identity",
    "oidc",
    "oauth2",
    "authentication",
    "authorization",
    "mfa",
    "webauthn",
    "passkeys",
    "multi-tenant",
    "hono",
    "sqlite",
    "drizzle",
    "valibot",
    "typescript",
    "bun",
    "cli",
    "adaptive-ds"
  ],
  "homepage": "https://github.com/david1gp/zitadel-v2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david1gp/zitadel-v2.git"
  },
  "bugs": {
    "url": "https://github.com/david1gp/zitadel-v2/issues"
  },
  "author": {
    "name": "David Siewert",
    "url": "https://david-siewert.com/"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/david1gp"
  },
  "license": "MIT",
  "readme": "README.md",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "main": "./dist/library/outputs/library.js",
  "types": "./dist/library/outputs/library.d.ts",
  "bin": {
    "zitadel-v2": "./dist/cli/cli.js"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run src/outputs/server.ts",
    "test": "bun test test/packageName.test.ts test/libraryExports.test.ts test/platform test/features test/cli test/conformance",
    "test:w": "bun test --watch test/packageName.test.ts test/libraryExports.test.ts test/platform test/features test/cli test/conformance",
    "test:build": "bun run build && bun test test/build",
    "test:all": "bun run test && bun run test:build",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "tsc": "tsc -p ./tsconfig.json --noEmit",
    "build": "bun run clean && bun run typecheck && bun run build:library && bun run build:server && bun run build:cli",
    "build:library": "tsc -p ./tsconfig.lib.json",
    "build:server": "bun build ./src/outputs/server.ts --outfile ./dist/server/server.js --target bun --format esm",
    "build:cli": "bun build ./src/outputs/cli.ts --outfile ./dist/cli/cli.js --target bun --format esm && chmod +x ./dist/cli/cli.js",
    "verify:outputs": "bun run test:build",
    "check": "bun run format:check && bun run typecheck && bun run test && bun run build && bun test test/build",
    "release": "bash ./ops/release.sh",
    "deploy": "bash ./ops/deploy.sh",
    "format": "biome format --write src test ops package.json tsconfig.json tsconfig.lib.json biome.json bunfig.toml cliff.toml README.md",
    "format:check": "biome format src test ops package.json tsconfig.json tsconfig.lib.json biome.json bunfig.toml cliff.toml README.md",
    "update": "bun update",
    "update:commit": "bun update && git add package.json && bun run tsc && git commit -m \"chore(deps): update dependencies\" && git push",
    "clean": "rm -rf ./dist",
    "reset": "rm -rf ./node_modules"
  },
  "peerDependencies": {
    "@adaptive-ds/result": ">=0.4.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "trailingComma": "all"
  },
  "imports": {
    "#result": "@adaptive-ds/result"
  },
  "exports": {
    ".": {
      "types": "./dist/library/outputs/library.d.ts",
      "import": "./dist/library/outputs/library.js"
    },
    "./library": {
      "types": "./dist/library/outputs/library.d.ts",
      "import": "./dist/library/outputs/library.js"
    },
    "./authorization": {
      "types": "./dist/library/outputs/library/authorization.d.ts",
      "import": "./dist/library/outputs/library/authorization.js"
    },
    "./emailOtp": {
      "types": "./dist/library/outputs/library/emailOtp.d.ts",
      "import": "./dist/library/outputs/library/emailOtp.js"
    },
    "./externalIdentities": {
      "types": "./dist/library/outputs/library/externalIdentities.d.ts",
      "import": "./dist/library/outputs/library/externalIdentities.js"
    },
    "./impersonation": {
      "types": "./dist/library/outputs/library/impersonation.d.ts",
      "import": "./dist/library/outputs/library/impersonation.js"
    },
    "./machineUsers": {
      "types": "./dist/library/outputs/library/machineUsers.d.ts",
      "import": "./dist/library/outputs/library/machineUsers.js"
    },
    "./mfa": {
      "types": "./dist/library/outputs/library/mfa.d.ts",
      "import": "./dist/library/outputs/library/mfa.js"
    },
    "./oidc": {
      "types": "./dist/library/outputs/library/oidc.d.ts",
      "import": "./dist/library/outputs/library/oidc.js"
    },
    "./organizations": {
      "types": "./dist/library/outputs/library/organizations.d.ts",
      "import": "./dist/library/outputs/library/organizations.js"
    },
    "./passkeys": {
      "types": "./dist/library/outputs/library/passkeys.d.ts",
      "import": "./dist/library/outputs/library/passkeys.js"
    },
    "./passwords": {
      "types": "./dist/library/outputs/library/passwords.d.ts",
      "import": "./dist/library/outputs/library/passwords.js"
    },
    "./projects": {
      "types": "./dist/library/outputs/library/projects.d.ts",
      "import": "./dist/library/outputs/library/projects.js"
    },
    "./realms": {
      "types": "./dist/library/outputs/library/realms.d.ts",
      "import": "./dist/library/outputs/library/realms.js"
    },
    "./sessions": {
      "types": "./dist/library/outputs/library/sessions.d.ts",
      "import": "./dist/library/outputs/library/sessions.js"
    },
    "./users": {
      "types": "./dist/library/outputs/library/users.d.ts",
      "import": "./dist/library/outputs/library/users.js"
    },
    "./server": {
      "import": "./dist/server/server.js"
    },
    "./cli": {
      "import": "./dist/cli/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.2.2",
    "@stricli/core": "^1.3.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2"
  }
}
