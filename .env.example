# Dedicated production authentication E2E credentials.
# Keep the real values in the gitignored local .env only.
AUTHWORKS_SSOTEST_USERNAME=ssotest
AUTHWORKS_SSOTEST_PASSWORD=replace-with-a-locally-generated-password

# Optional session IP geolocation. When set, active sessions are enriched with
# country and region in the background without delaying sign-in. Leave unset to
# disable enrichment. Uses an ipapi-compatible JSON endpoint.
# AUTHWORKS_GEO_LOOKUP_URL=https://ipapi.co/

# The production ensure command currently accepts AUTHWORKS_CONTENTOREN_SSOTEST_EMAIL and
# AUTHWORKS_CONTENTOREN_SSOTEST_PASSWORD; bridge those inputs privately at invocation time.
# Do not add that email, the system token, or either secret to tracked files.
