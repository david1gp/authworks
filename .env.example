# Dedicated production authentication E2E credentials.
# Keep the real values in the gitignored local .env only.
AUTHWORKS_SSOTEST_USERNAME=ssotest
AUTHWORKS_SSOTEST_PASSWORD=replace-with-a-locally-generated-password

# Session IP geolocation. Active sessions are enriched with country and region
# in the background without delaying sign-in. Leave unset to use the default
# public endpoint (http://ip-api.com/json/, free without an account, plain HTTP
# only on the free tier); set to an empty value to disable enrichment. A custom
# ip-api.com-compatible JSON endpoint URL overrides the default.
# AUTHWORKS_GEO_LOOKUP_URL=http://ip-api.com/json/

# The production ensure command currently accepts AUTHWORKS_CONTENTOREN_SSOTEST_EMAIL and
# AUTHWORKS_CONTENTOREN_SSOTEST_PASSWORD; bridge those inputs privately at invocation time.
# Do not add that email, the system token, or either secret to tracked files.

# Browser console diagnostics. E2E runs print captured browser console errors/warnings only for
# failing tests; set AUTHWORKS_E2E_CONSOLE=1 to print them for every test. The vite dev server no
# longer forwards browser console output to the terminal; set AUTHWORKS_UI_FORWARD_CONSOLE=1 to
# re-enable it.
# AUTHWORKS_E2E_CONSOLE=1
# AUTHWORKS_UI_FORWARD_CONSOLE=1

# Server runtime inventory. Every AUTHWORKS_* name below is parsed from the
# environment by src/outputs/server.ts and the configuration parsers; nothing
# here is read from committed files. Copy the names you need into the
# gitignored local .env (mode 600) with real values. Never commit secrets.
#
# Base runtime (src/platform/configuration/configurationParse.ts).
# Optional unless noted; defaults shown. Legacy DATABASE_PATH/HOST/PORT/
# PUBLIC_ORIGIN fallbacks still work but the AUTHWORKS_* names win on conflict.
# Required: public origin of the deployment (must be https in production).
AUTHWORKS_PUBLIC_ORIGIN=https://auth.example.com
# Optional: SQLite path, bind host/port, NODE_ENV, trusted-proxy list.
# AUTHWORKS_DATABASE_PATH=authworks.sqlite
# AUTHWORKS_HOST=127.0.0.1
# AUTHWORKS_PORT=3000
# NODE_ENV=development
# AUTHWORKS_TRUSTED_PROXY_ADDRESSES=
#
# System secret. Optional at boot; required when WAHA is enabled, and used for
# MFA secret encryption plus rate-limit key derivation. No default.
# AUTHWORKS_SYSTEM_SECRET=replace-with-a-secret
#
# Transactional email (src/features/email/server/mailTransportConfigurationParse.ts).
# Optional: disabled unless AUTHWORKS_EMAIL_DELIVERY_ENABLED is 1/true. When
# enabled, every SMTP_* name plus AUTHWORKS_EMAIL_GENERATOR_BASE_URL is required.
# AUTHWORKS_EMAIL_DELIVERY_ENABLED=true
# AUTHWORKS_EMAIL_SMTP_HOST=mail.example.com
# AUTHWORKS_EMAIL_SMTP_PORT=587
# AUTHWORKS_EMAIL_SMTP_SECURITY=starttls
# AUTHWORKS_EMAIL_SMTP_USERNAME=mailer@example.com
# AUTHWORKS_EMAIL_SMTP_PASSWORD=replace-with-a-secret
# AUTHWORKS_EMAIL_SMTP_FROM=mailer@example.com
# AUTHWORKS_EMAIL_GENERATOR_BASE_URL=https://email-generator.example.com
# Optional email footer/invitation overrides.
# AUTHWORKS_EMAIL_FOOTER_HOMEPAGE_TEXT=
# AUTHWORKS_EMAIL_FOOTER_HOMEPAGE_URL=
# AUTHWORKS_EMAIL_FOOTER_HOMEPAGE_SUBTITLE=
# AUTHWORKS_EMAIL_FOOTER_LANGUAGE=
# AUTHWORKS_EMAIL_FOOTER_LEGAL_SIGNATURE=
# AUTHWORKS_EMAIL_INVITATION_SENDER_EMAIL=
# AUTHWORKS_EMAIL_INVITATION_SENDER_NAME=
#
# WhatsApp OTP via WAHA (src/features/waha/server/wahaConfigurationParse.ts).
# Optional: disabled unless AUTHWORKS_WAHA_ENABLED is 1/true/yes. When enabled,
# AUTHWORKS_WAHA_ENDPOINTS (JSON array) and a non-empty AUTHWORKS_SYSTEM_SECRET
# are required; the interval/TTL names are optional (defaults 30000/90000).
# AUTHWORKS_WAHA_ENABLED=true
# AUTHWORKS_WAHA_ENDPOINTS='[{"id":"local","baseUrl":"http://localhost:3000"}]'
# AUTHWORKS_WAHA_REFRESH_INTERVAL_MS=30000
# AUTHWORKS_WAHA_FRESHNESS_TTL_MS=90000
#
# Profile-picture object storage (src/platform/configuration/r2ConfigurationParse.ts).
# Optional as a group: unset disables R2. If any name is set, all five are required.
# AUTHWORKS_R2_ACCOUNT_ID=
# AUTHWORKS_R2_ACCESS_KEY_ID=
# AUTHWORKS_R2_SECRET_ACCESS_KEY=replace-with-a-secret
# AUTHWORKS_R2_BUCKET_NAME=
# AUTHWORKS_R2_PUBLIC_BASE_URL=https://pictures.example.com
#
# CLI connection and scope defaults
# (src/features/centralConfiguration/config/authworksConfigurationResolve.ts).
# All optional; explicit flags always win. AUTHWORKS_URL defaults to
# http://127.0.0.1:3000; AUTHWORKS_BASE_URL/AUTHWORKS_SERVER are aliases.
# AUTHWORKS_URL=http://127.0.0.1:3000
# AUTHWORKS_TOKEN=replace-with-a-secret
# AUTHWORKS_PROFILE=
# AUTHWORKS_DEFAULT_PROFILE=
# AUTHWORKS_PROJECT=
# AUTHWORKS_PROJECT_ID=
# AUTHWORKS_REALM_ID=
# AUTHWORKS_ORGANIZATION_ID=
# AUTHWORKS_ENV_FILE=
#
# Offline Zitadel migration CLI
# (src/features/zitadelMigration/cli/zitadelMigrationCliCommands.ts).
# Both optional flag defaults: snapshot input/output path and provider
# credentials path for IdP reconfiguration at import.
# AUTHWORKS_MIGRATION_SNAPSHOT_PATH=
# AUTHWORKS_MIGRATION_PROVIDER_CREDENTIALS_PATH=
#
# Public HTTPS smoke (ops/public-smoke.sh). Required by the smoke script;
# optional for the server itself.
# AUTHWORKS_SMOKE_URL=https://auth.example.com
# AUTHWORKS_SMOKE_TIMEOUT_SECONDS=15
